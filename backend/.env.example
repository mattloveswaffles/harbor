# Copy this file to .env (git ignores .env) and fill in your own keys.
# Never commit real keys.

HARBOR_MODE=demo

# Capital One Nessie: log in at nessieisreal.com with GitHub, then open Profile
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_MODE=live

# Anthropic (AI review and explanations); leave blank to run with the template text only
ANTHROPIC_API_KEY=
HARBOR_MODEL=claude-opus-5-5

# OpenRouteService (routing): free key at openrouteservice.org
ORS_API_KEY=
# GSA per diem (lodging estimates): free key at api.data.gov
GSA_API_KEY=
# NOAA/NWS ask for a User-Agent that identifies you, e.g. "Harbor (you@example.com)"
NOAA_USER_AGENT=

DEMO_CANCEL_WINDOW_S=20
# Hours before tropical-storm winds that evacuation money must be in checking
EVAC_LEAD_HOURS=6

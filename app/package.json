{
  "name": "harbor-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun build ./index.html --outdir dist --splitting --public-path / --watch",
    "build": "bun build.ts",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests/*.ts ./tests/*.tsx"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@happy-dom/global-registrator": "^21.0.3",
    "@types/bun": "^1.4.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}

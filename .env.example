# Harbor settings. Copy to .env (git ignores it) and fill in what you need.
# NESSIE_API_KEY is required; everything else is optional.

# --- Server (read by server/harbor/config.py) ---------------------------------------------

# demo: replays Hurricane Milton on a demo clock with /demo controls. live: real time, real NOAA data.
HARBOR_MODE=demo

# Bank: Capital One's Nessie sandbox. Every connection and money move goes through it.
# Key: log in at http://nessieisreal.com with GitHub, then open Profile.
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com

# Every agent (Ask Harbor and the evacuation advice) runs on one model through OpenRouter.
# Blank key = the AI is off and Harbor's rules answer. Key: https://openrouter.ai/keys
# LLM_MODEL is a comma-separated list: the first model answers, the next take over when it fails.
OPENROUTER_API_KEY=
LLM_MODEL=poolside/laguna-s-2.1:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free

# Live-mode data sources (demo mode uses recorded data and needs none of these)
# Routing, free key at openrouteservice.org
ORS_API_KEY=

# Plan timing
# Hours before storm winds that the money must be in checking
EVAC_LEAD_HOURS=6

# Origins allowed to call the API from another site (JSON list), e.g. a GitHub Pages build
CORS_ORIGINS=["http://localhost:3000"]

# Defaults that rarely need changing:
# DATABASE_URL=sqlite:///server/harbor.db
# SITE_DIR=app/dist        # the built website served at /
# REPLAY_DIR=server/data/replays   # storm replays built by tools/fetch_replay.py
# DEMO_START=2024-10-06T03:00:00Z  # where the demo clock waits until /demo/start
# DEMO_SPEED=1800                  # storm seconds per real second
# TICK_SECONDS=                    # scheduler interval; blank = 2 s in demo mode, 60 s in live mode
# SCHEDULER_ENABLED=true

# --- Docker -------------------------------------------------------------------------------

PORT=3000

# --- Website build (app/build.ts) ---------------------------------------------------------

# Path the site is served under (GitHub Pages uses /<repo>; CI sets it). Blank = /.
HARBOR_BASE_PATH=
# A deployed Harbor server for a static build. Blank = same origin.
HARBOR_API_URL=
